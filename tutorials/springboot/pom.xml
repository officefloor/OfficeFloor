<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>net.officefloor.tutorial</groupId>
		<artifactId>tutorials</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>springboot</artifactId>
	<packaging>pom</packaging>
	<name>Spring Boot Tutorials</name>
	<description>Tutorials for OfficeFloor Spring Boot integration</description>
	<dependencyManagement>
		<dependencies>
			<!-- All springboot tutorials use Spring Boot 4 (except SpringRestSpringBoot3HttpServer) -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring4-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Hibernate 7 (used by SB4) requires Jakarta Persistence 3.2; root BOM pins 3.1 -->
			<dependency>
				<groupId>jakarta.persistence</groupId>
				<artifactId>jakarta.persistence-api</artifactId>
				<version>3.2.0</version>
			</dependency>
			<!-- SB4 modularised test artifacts -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-webmvc-test</artifactId>
				<version>${spring4-version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-resttestclient</artifactId>
				<version>${spring4-version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-restclient</artifactId>
				<version>${spring4-version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-security-test</artifactId>
				<version>${spring4-version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring4-version}</version>
				</plugin>
				<!-- SB4 requires Kotlin 2.x; root BOM pins kotlin-maven-plugin to 1.9.x -->
				<plugin>
					<groupId>org.jetbrains.kotlin</groupId>
					<artifactId>kotlin-maven-plugin</artifactId>
					<version>${kotlin4-version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<modules>
		<module>SpringRestHttpServer</module>
		<module>SpringRestFunctionHttpServer</module>
		<module>SpringRestExceptionHttpServer</module>
		<module>SpringRestSecurityHttpServer</module>
		<module>SpringRestValidationHttpServer</module>
		<module>SpringRestCorsHttpServer</module>
		<module>SpringRestOpenApiHttpServer</module>
		<module>SpringRestThymeleafHttpServer</module>
		<module>SpringRestServletHttpServer</module>
		<module>SpringRestQualifierHttpServer</module>
		<module>SpringRestDataJpaHttpServer</module>
		<module>SpringRestTeamHttpServer</module>
		<module>SpringRestManagedObjectHttpServer</module>
		<module>SpringRestSupplierHttpServer</module>
		<module>SpringRestGovernanceHttpServer</module>
		<module>SpringRestActuatorHttpServer</module>
		<module>SpringRestConversionReference</module>
		<module>SpringRestVariableHttpServer</module>
		<module>SpringRestSpringBoot3HttpServer</module>
		<module>SpringRestKotlinHttpServer</module>
		<module>SpringRestScalaHttpServer</module>
		<module>SpringRestJavaScriptHttpServer</module>
		<module>SpringRestCatsHttpServer</module>
		<module>SpringRestZioHttpServer</module>
	</modules>
</project>
